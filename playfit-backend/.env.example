# Ejemplo. NO lo uses tal cual: corre "npm run setup" y se genera tu .env con secretos aleatorios.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=playfit_dev
DB_USER=playfit_app
DB_PASS=playfit_dev_pass
APP_TZ=America/Bogota
JWT_SECRET=genera-uno-con-npm-run-setup
CLINICAL_KEY=genera-uno-con-npm-run-setup
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
AUTH_PORT=3001
CLINICAL_PORT=3002
SOCIAL_PORT=3003
CONTENT_PORT=3004
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10
CORS_ORIGINS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
IA_LIMITE_DIARIO=20
# --- Correo (recuperacion de contrasena) con Brevo: https://www.brevo.com (plan gratis). Sin clave, el codigo se imprime en la consola. ---
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=PlayFit
# --- 2FA: el admin DEBE tener verificacion en dos pasos. Pon 0 solo en tu PC para entrar sin ella al probar. ---
ADMIN_2FA_OBLIGATORIO=1
# --- Fase 14: PlayFit Premium y pagos con Wompi en SANDBOX (no se cobra plata real). Llaves en comercios.wompi.co > Desarrolladores ---
IA_LIMITE_PREMIUM=60
PREMIUM_PRECIO_COP=9900
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# A donde vuelve el usuario despues de pagar. En el PC usa la IP de tu PC para que el celular llegue:
# http://IP-DE-TU-PC:3000/api/social/payments/wompi/return
WOMPI_REDIRECT_URL=
