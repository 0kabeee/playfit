    {
      "parameters": {
        "jsCode": "// Un aviso por squad con los numeros de la semana. Cada item termina en una llamada a /notificaciones.\nconst { squads } = $input.first().json;\nreturn squads.map((s) => {\n  const cuerpo = s.sesiones === 0\n    ? 'Esta semana nadie entreno. Propongan un reto para arrancar la proxima.'\n    : `${s.activos} de ${s.miembros} entrenaron: ${s.sesiones} sesiones y ${s.reps} repeticiones. ${s.retos_vigentes ? 'Tienen ' + s.retos_vigentes + ' reto(s) en curso.' : 'Creen un reto para la proxima semana.'}`;\n  return { json: { usuario_ids: s.usuario_ids, tipo: 'resumen_semanal', titulo: `Semana de ${s.nombre}`.slice(0, 100), cuerpo: cuerpo.slice(0, 255) }, pairedItem: 0 };\n});"
      },
      "id": "7da10376-5340-4665-88ec-639b79af8e08",
      "name": "Un mensaje por squad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
